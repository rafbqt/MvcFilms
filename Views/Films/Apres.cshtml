@model List<MvcFilms.Models.Film>

<h1>Films après l'année demandée</h1>

@if (Model.Count == 0)
{
    <p>Aucun film trouvé.</p>
}
else
{
    <ul>
    @foreach (var film in Model)
    {
        <li>@film.Titre — @film.Realisateur — @film.Annee</li>
    }
    </ul>
}

<a asp-action="Index">Retour à la liste</a>